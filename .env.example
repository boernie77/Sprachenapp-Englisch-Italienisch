# Kopiere diese Datei als ".env" und fülle die Werte aus.
# Die .env-Datei ist in .gitignore und wird NICHT ins Repository eingecheckt.

# --- Anwendung ---
APP_PORT=9011
# Pflicht: mindestens 32 zufällige Zeichen, z. B. openssl rand -base64 48
JWT_SECRET=
# Öffentliche Adresse der App (für Links in E-Mails)
APP_URL=http://localhost:9011

# --- Datenbank ---
DB_NAME=lernapp
# Nur Buchstaben, Zahlen und _ verwenden
DB_PASSWORD=
DB_PORT=5436

# --- Betreiber (optional) ---
# Feste Einladungscodes, kommagetrennt. Leer = Registrierung nur mit Codes aus dem Admin-Bereich
# (der erste registrierte Nutzer wird automatisch Admin und braucht keinen Code).
STATIC_INVITE_CODES=
# Empfänger des Kontaktformulars. Leer = Kontaktformular ist deaktiviert.
CONTACT_EMAIL=

# --- E-Mail (SMTP, optional – für Passwort-Zurücksetzen und Kontaktformular) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Single Sign-on (optional, z. B. Authentik) ---
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
